# Copy this file to .env (never commit .env). Spring reads it on startup (application.yml).
DB_URL=jdbc:postgresql://localhost:5432/abanyabiraka
DB_USERNAME=postgres
DB_PASSWORD=postgres
# At least 32 characters or the app won't start. Generate one: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-in-production-0123456789
JWT_EXPIRATION_MS=86400000

# Gmail SMTP for OTP emails (Google App Password, not your normal password). Empty = codes only in the log.
MAIL_USERNAME=
MAIL_PASSWORD=

# Or send through Brevo's HTTPS API (needed on Render's free plan, which blocks SMTP). Takes priority over SMTP.
# MAIL_FROM must be a sender verified in Brevo. MAIL_FROM defaults to MAIL_USERNAME.
BREVO_API_KEY=
MAIL_FROM=
